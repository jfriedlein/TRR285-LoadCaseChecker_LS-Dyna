# path to lsdyna executable
path2lsdynaExe=./
# name of lsdyna executable
exeName=lsdyna
# name of LS-Dyna input keyword file
inputFile=1_main.k
# number of CPUs to be used
NCPU=7

# Delete old d3* results [https://superuser.com/questions/482435/how-to-remove-all-files-starting-with-a-certain-string-in-linux]
rm -rf d3*

# Copy lsdyna executable into current directory (optional, but sometimes helpful for archiving)
$rm $exeName
cp -r $path2lsdynaExe/$exeName .

# Run the copied lsdyna executable with the given input file and set number of CPUs
./$exeName i=$inputFile NCPU=$NCPU
